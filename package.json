{
  "name": "presentedealegria-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-seo.mjs && node scripts/build-pwa.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rls": "bash scripts/test-rls.sh",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "signature_pad": "5.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT"
}
